# Scope tier: dev | regional | global
# Start with dev (single small bounding box) to prove the pipeline quickly.
# regional = one country/state extract
# global = full planet (150+ GB pbf, ~256 GB imported DB)
SCOPE_TIER=dev

# --- dev tier: single small bounding box for fast iteration ---
# Austin, TX bounding box
DEV_BBOX_MINLON=-97.85
DEV_BBOX_MINLAT=30.10
DEV_BBOX_MAXLON=-97.55
DEV_BBOX_MAXLAT=30.45
DEV_BBOX_NAME=austin-tx

# --- regional tier: one country/continent extract ---
REGIONAL_EXTRACT_URL=https://download.geofabrik.de/north-america/us/texas-latest.osm.pbf
REGIONAL_NAME=texas

# --- global tier: no bbox filtering (full planet) ---
# Flip SCOPE_TIER=global once dev and regional have passed every test.
