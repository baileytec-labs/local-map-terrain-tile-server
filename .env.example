# Scope tier: dev | regional | global
# dev = single small bounding box (fast iteration, ~10 GB total)
# regional = one country/state extract (tens of GB)
# global = full planet (~79 GB PBF, ~320 GB PostGIS, ~900 GB total on disk)
SCOPE_TIER=global

# --- dev tier: single small bounding box for fast iteration ---
# Austin, TX bounding box
# DEV_BBOX_MINLON=-97.85
# DEV_BBOX_MINLAT=30.10
# DEV_BBOX_MAXLON=-97.55
# DEV_BBOX_MAXLAT=30.45
# DEV_BBOX_NAME=austin-tx

# --- regional tier: one country/continent extract ---
# REGIONAL_EXTRACT_URL=https://download.geofabrik.de/north-america/us/texas-latest.osm.pbf
# REGIONAL_NAME=texas

# --- global tier: full planet ---
GLOBAL_EXTRACT_URL=https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf

# Required for docker-compose volume mount — the PBF filename must match
DEV_BBOX_NAME=planet-latest
